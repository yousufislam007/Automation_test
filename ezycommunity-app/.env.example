# Accounts used to log in to the EzyCommunity Android app
TEST_MEMBER_EMAIL=
TEST_MEMBER_PASSWORD=
# The community owner / admin account (only for owner tests)
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Which emulator/device and which app to test. Defaults are the emulator and the values shown for the app.
# ANDROID_DEVICE_NAME=emulator-5554
# ANDROID_PLATFORM_VERSION=17
# APP_PACKAGE=com.ezycommunity.android
# APP_ACTIVITY=.MainActivity

# Keep the app's saved login between runs (default). Set to 0 to start from a clean app every session.
# APP_NO_RESET=
# Set to 1 for one run after an appium-uiautomator2-driver upgrade or on a new phone: (re)installs the UiAutomator2
# helper apps. Normally unset, so sessions start fast (skipServerInstallation + skipDeviceInitialization).
# APP_FULL_INIT=
# Port of the Appium server (default 4723). Start one with `npm run appium` and the tests reuse it.
# APPIUM_PORT=0
# Real logins allowed per window before the tests refuse to log in again, and the window in minutes.
# The site is assumed to allow about 10 login requests per window, then HTTP 429 for 10-15 minutes.
# LOGIN_BUDGET_MAX=8
# LOGIN_BUDGET_WINDOW_MIN=15
