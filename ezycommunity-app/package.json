{
  "name": "ezycommunity-android-automation",
  "version": "1.0.0",
  "private": true,
  "description": "EzyCommunity Android app tests (Appium + WebdriverIO). Self-contained: install and run from this folder.",
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "test:smoke": "wdio run wdio.conf.ts --spec tests/smoke/launch.spec.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@wdio/appium-service": "^10.0.2",
    "@wdio/cli": "^10.0.2",
    "@wdio/globals": "^10.0.2",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "expect-webdriverio": "^8.0.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "webdriverio": "^10.0.2"
  }
}
