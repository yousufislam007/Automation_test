# Account used to log in to the EzyCourse Android app
TEST_STUDENT_EMAIL=
TEST_STUDENT_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Course names for the course tests (never printed in logs)
# A course the test student is enrolled in
COURSE_NAME=
# A bundle the test student owns (the name on the "Bundle courses" tab)
BUNDLE_COURSE_NAME=

# Optional: which emulator/device and which app to test. Defaults are shown; remove the # to change one.
# ANDROID_DEVICE_NAME=emulator-5554
# ANDROID_PLATFORM_VERSION=17
# APP_PACKAGE=com.ezycourse.ezycourse
# APP_ACTIVITY=.EzyAudioServiceActivity

# Set to 1 for one run after an appium-uiautomator2-driver upgrade or on a new device: (re)installs the UiAutomator2
# helper apps. Normally unset, so sessions start fast (skipServerInstallation + skipDeviceInitialization).
# APP_FULL_INIT=
# Port of the Appium server (default 4723). Start one with `npm run appium` and the tests reuse it.
# APPIUM_PORT=
