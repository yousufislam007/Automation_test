# Copy this file to .env and fill in real values. .env is git-ignored.
WEB_BASE_URL=
WEB_ADMIN_EMAIL=
WEB_ADMIN_PASSWORD=

# Number of parallel workers. Default 3 (page loads stay spaced out by the shared limiter). Set 1 if the site
# starts answering HTTP 429.
# PLAYWRIGHT_WORKERS=3
# Minimum gap (ms) between page loads across ALL workers. Default 0 for one worker, 1000 for more.
# REQUEST_MIN_INTERVAL_MS=1000
# Set to 1 to force a fresh login even if the saved session is still valid.
# AUTH_REFRESH=1
# A saved session checked less than this many minutes ago is trusted without opening the site (saves ~5 s per run).
# 0 = always check.
# AUTH_TRUST_MIN=20
# Set to 1 to record a trace for every test and keep it on failure (costs about 10% per test; off by default).
# PLAYWRIGHT_TRACE=1

# Only for tests that change data AND run with more than one worker: one extra admin account per
# extra worker (slot 1, 2, ...). Accounts are never created automatically.
# WEB_ADMIN_EMAIL_1=
# WEB_ADMIN_PASSWORD_1=

# The dedicated QA course used by the course tests (defaults are the QA-Explore course).
# QA_COURSE_ID=49589
# QA_CHAPTER_ID=168197
# QA_COURSE_NAME=QA-Explore Course
# Slow every browser action by this many ms (useful with --headed).
# PLAYWRIGHT_SLOW_MO=400

# Disposable marketplace seller for the seller tests (use an address that receives no mail).
# QA_SELLER_EMAIL=
# QA_SELLER_PASSWORD=
