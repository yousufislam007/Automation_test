# Copy this file to .env and fill in real values. .env is git-ignored.
# The EzyCommunity site under test, for example https://yourcommunity.example.com
WEB_BASE_URL=https://sqa.ezycommunity.pro.bd

# The site owner / admin account
WEB_ADMIN_EMAIL=
WEB_ADMIN_PASSWORD=

# A normal member account (for member-side tests)
WEB_MEMBER_EMAIL=
WEB_MEMBER_PASSWORD=

# Number of parallel workers. Default 3 (page loads stay spaced out by the shared limiter; logins are budgeted).
# Set 1 if the site starts answering HTTP 429.
# PLAYWRIGHT_WORKERS=3
# Slow every browser action by this many ms (useful with --headed).
# PLAYWRIGHT_SLOW_MO=400

# Minimum gap (ms) between page loads across ALL workers. Default 0 for one worker, 1000 for more.
# REQUEST_MIN_INTERVAL_MS=1000
# Set to 1 to force a fresh login even if the saved session is still valid.
# AUTH_REFRESH=1
# A saved session checked less than this many minutes ago is trusted without opening the site (saves ~5 s per run).
# 0 = always check.
# AUTH_TRUST_MIN=20
# Set to 1 to record a trace for every test and keep it on failure (costs about 10% per test; off by default).
# PLAYWRIGHT_TRACE=1
# Real logins allowed per window before the tests refuse to log in again, and the window in minutes.
# The site is assumed to allow about 10 login requests per window, then HTTP 429 for 10-15 minutes.
# LOGIN_BUDGET_MAX=8
# LOGIN_BUDGET_WINDOW_MIN=15
